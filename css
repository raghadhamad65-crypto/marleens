/* =========================================================
   Footer
/* =========================================================
   FOOTER — MARLEEN'S OIL
========================================================= */

.footer {
  position: relative;
  overflow: hidden;

  background: #3E4A32;
  color: rgba(246,241,231,0.85);

  padding: 70px 0 24px;
}


/* ===== إضاءة ذهبية خلف الفوتر ===== */

.footer::before {
  content: "";
  position: absolute;

  width: 420px;
  height: 420px;

  left: -180px;
  bottom: -230px;

  border-radius: 50%;

  background: rgba(218,190,75,0.10);

  filter: blur(90px);

  pointer-events: none;
}


/* ===== إضاءة ثانية ===== */

.footer::after {
  content: "";
  position: absolute;

  width: 300px;
  height: 300px;

  right: -140px;
  top: -180px;

  border-radius: 50%;

  background: rgba(190,157,91,0.08);

  filter: blur(80px);

  pointer-events: none;
}


/* ===== محتوى الفوتر ===== */

.container_footer__inner {
  position: relative;
  z-index: 3;

  display: grid;

  grid-template-columns: 1.4fr 1fr 1fr;

  gap: 50px;

  padding-bottom: 50px;

  border-bottom: 1px solid rgba(246,241,231,0.12);
}


/* ===== اللوجو ===== */

.footer__logo {
  height: 34px;
  margin-bottom: 16px;

  filter: brightness(0) invert(1);

  transition: 0.4s ease;
}

.footer__logo:hover {
  transform: translateY(-3px);
}


/* ===== وصف البراند ===== */

.footer__brand p {
  color: rgba(246,241,231,0.65);

  font-size: 14px;

  max-width: 280px;

  line-height: 1.9;
}


/* ===== عناوين الأعمدة ===== */

.footer__col h4 {
  position: relative;

  color: var(--white);

  font-family: var(--font-body);

  font-size: 16px;

  margin-bottom: 20px;

  width: fit-content;
}


/* خط ذهبي صغير تحت العنوان */

.footer__col h4::after {
  content: "";

  display: block;

  width: 28px;
  height: 2px;

  margin-top: 8px;

  border-radius: 10px;

  background: var(--gold-light);

  box-shadow:
    0 0 8px rgba(218,190,75,0.45);
}


/* ===== الروابط ===== */

.footer__col a {
  position: relative;

  display: block;

  width: fit-content;

  color: rgba(246,241,231,0.65);

  margin-bottom: 12px;

  font-size: 14.5px;

  text-decoration: none;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.footer__col a:hover {
  color: var(--gold-light);

  transform: translateX(-6px);

  text-shadow:
    0 0 12px rgba(218,190,75,0.25);
}


/* ===== الخط السفلي ===== */

.footer__bottom {
  position: relative;
  z-index: 3;

  text-align: center;

  padding: 24px 0 5px;

  font-size: 13px;

  color: rgba(246,241,231,0.45);
}


/* =========================================================
   🌿 أوراق الزيتون والبذور
========================================================= */

.footer__decor {
  position: absolute;

  inset: 0;

  pointer-events: none;

  overflow: hidden;

  z-index: 1;
}


/* ورقة */

.footer-leaf {
  position: absolute;

  width: 42px;
  height: 18px;

  border-radius: 100% 0 100% 0;

  background: linear-gradient(
    135deg,
    rgba(145,157,92,0.38),
    rgba(65,80,45,0.22)
  );

  opacity: 0.55;

  animation: footerLeafFloat 8s ease-in-out infinite;
}


/* عرق الورقة */

.footer-leaf::after {
  content: "";

  position: absolute;

  width: 30px;
  height: 1px;

  left: 6px;
  top: 9px;

  background: rgba(218,190,75,0.4);

  transform: rotate(-8deg);
}


/* أماكن الأوراق */

.footer-leaf.one {
  left: 6%;
  top: 18%;

  transform: rotate(-30deg);

  animation-delay: 0s;
}

.footer-leaf.two {
  right: 9%;
  top: 25%;

  transform: rotate(35deg);

  animation-delay: 2s;
}

.footer-leaf.three {
  right: 20%;
  bottom: 12%;

  transform: rotate(-20deg);

  animation-delay: 4s;
}


/* ===== البذور ===== */

.footer-seed {
  position: absolute;

  width: 7px;
  height: 12px;

  border-radius: 60% 40% 55% 45%;

  background: #c4a75a;

  opacity: 0.45;

  box-shadow:
    0 0 8px rgba(218,190,75,0.3);

  animation: footerSeedFloat 6s ease-in-out infinite;
}

.footer-seed.one {
  left: 25%;
  top: 22%;
}

.footer-seed.two {
  left: 42%;
  bottom: 20%;

  animation-delay: 2s;
}

.footer-seed.three {
  right: 30%;
  top: 18%;

  animation-delay: 3s;
}

.footer-seed.four {
  right: 12%;
  bottom: 25%;

  animation-delay: 1s;
}


/* =========================================================
   ✨ الحركات
========================================================= */

@keyframes footerLeafFloat {

  0% {
    transform: translateY(0) rotate(-25deg);
  }

  50% {
    transform: translateY(-14px) rotate(-8deg);
  }

  100% {
    transform: translateY(0) rotate(-25deg);
  }

}


@keyframes footerSeedFloat {

  0% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-20px) rotate(25deg);
  }

  100% {
    transform: translateY(0) rotate(0deg);
  }

}


