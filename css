/* =========================================
   🌿🌿 Nature Burst - اطلب الآن
========================================= */

.nature-particle {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 999999;
  pointer-events: none;
  opacity: 0;

  --x: 0px;
  --y: 0px;
  --rotate: 0deg;

  transform:
    translate(-50%, -50%)
    translate(0, 0)
    rotate(0deg)
    scale(.2);

  animation: natureBurst .95s cubic-bezier(.15,.75,.25,1) forwards;
}

/* 🌿 ورقة زيتون */
.nature-particle.leaf {
  width: 25px;
  height: 12px;

  border-radius: 100% 0 100% 0;

  background: linear-gradient(
    135deg,
    #89955c,
    #485637
  );

  box-shadow:
    0 3px 8px rgba(35,45,25,.25);
}

/* عرق الورقة */
.nature-particle.leaf::after {
  content: "";
  position: absolute;

  width: 17px;
  height: 1px;

  background: rgba(220,210,160,.7);

  left: 4px;
  top: 6px;

  transform: rotate(-8deg);
}

/* 🫒 حبة زيتون */
.nature-particle.olive {
  width: 15px;
  height: 20px;

  border-radius: 50% 50% 48% 48%;

  background:
    radial-gradient(
      circle at 32% 25%,
      #a0ad6b 0%,
      #657344 35%,
      #37452b 75%,
      #25301e 100%
    );

  box-shadow:
    0 3px 8px rgba(30,40,20,.3);
}

/* 🌰 البذرة */
.nature-particle.seed {
  width: 6px;
  height: 10px;

  border-radius: 60% 40% 55% 45%;

  background: #b99b59;

  box-shadow:
    0 2px 5px rgba(70,55,25,.25);
}


/* الحركة */
@keyframes natureBurst {

  0% {
    opacity: 0;

    transform:
      translate(-50%, -50%)
      translate(0, 0)
      rotate(0deg)
      scale(.2);
  }

  15% {
    opacity: 1;
  }

  70% {
    opacity: 1;
  }

  100% {
    opacity: 0;

    transform:
      translate(-50%, -50%)
      translate(var(--x), var(--y))
      rotate(var(--rotate))
      scale(1);
  }
}
