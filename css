/* =========================================================
   Hero — Cinematic Beauty Ad
   ========================================================= */
   
.hero{
  position:relative;
  height:100vh;
  min-height:640px;
  overflow:hidden;
  background:#0E0C09; /* fallback while video/poster loads */
}

.hero__media{
  position:absolute;
  inset:0;
  z-index:0;
}.hero__video {
  width: 100%;
  height: 100%;

  object-fit: cover;

  /* نرفع الكادر حتى يظهر غطاء المنتج */
  object-position: center 30%;

  animation: heroSlowDrift 22s ease-in-out infinite alternate;

object-position: center 25%;}

@keyframes heroSlowDrift {
  0% {
    transform: scale(1.01) translate(0, 0);
  }

  100% {
    transform: scale(1.06) translate(-0.5%, -0.3%);
  }
}

/* فينييت ناعم لتركيز النظر على مركز المشهد */
.hero__vignette{
  position:absolute; inset:0;
  box-shadow:inset 0 0 180px 40px rgba(0,0,0,0.55);
  pointer-events:none;
}

/* قطرات/particles راقية جداً وخفيفة */
.hero__particles{ position:absolute; inset:0; pointer-events:none; z-index:1; }
.hero__particle{
  position:absolute;
  width:5px; height:5px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(217,184,136,0.9), rgba(217,184,136,0));
  opacity:0;
  animation:particleDrift 9s ease-in infinite;
}
.hero__particle--1{ left:32%; bottom:10%; animation-delay:1.2s; }
.hero__particle--2{ left:48%; bottom:0%; animation-delay:4s; width:3px; height:3px; }
.hero__particle--3{ left:60%; bottom:6%; animation-delay:6.5s; width:4px; height:4px; }
@keyframes particleDrift{
  0%{ transform:translateY(0); opacity:0; }
  15%{ opacity:.7; }
  85%{ opacity:.3; }
  100%{ transform:translateY(-220px); opacity:0; }
}

/* المحتوى: علامة + عنوان + زر فقط، بلا ازدحام */
.hero__content{
  position:relative;
  z-index:2;
  height:100%;
  max-width:1180px;
  margin:0 auto;
  padding:0 28px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  align-items:flex-start;
  padding-bottom:14%;
  text-align:left;
  transform: translateX(35px);
}

.hero__brand{
  color:var(--cream-alt);
  font-family:var(--font-body);
  font-weight:600;
  letter-spacing:4px;
  font-size:14px;
  margin:0 0 18px;
  opacity:0;
  animation:heroRise 1s ease forwards;
  animation-delay:1s;
}
/* الخلفية خلف النص فقط */
.hero__tagline::before {
  content: "";
  position: absolute;
  z-index: -1;

  top: -35px;
  bottom: -35px;
  left: -55px;
  right: -55px;

  background: radial-gradient(
    ellipse at center,
    rgba(245, 240, 225, 0.88) 0%,
    rgba(245, 240, 225, 0.55) 45%,
    rgba(245, 240, 225, 0) 78%
  );

  filter: blur(3px);
  pointer-events: none;
}

.hero__tagline span {
  color: #464030;

  text-shadow:
    0 0 5px rgba(241, 237, 222, 0.86),
    0 0 15px rgba(231, 226, 207, 0.903),
    0 0 30px rgba(218, 190, 75, 0.30),
    0 0 55px rgba(218, 190, 75, 0.18);
}

/* الموبايل */
@media (max-width: 768px) {
  .hero__tagline {
    left: 0;
    font-size: clamp(30px, 9vw, 46px);
  }

  .hero__tagline::before {
    top: -28px;
    bottom: -28px;
    left: -35px;
    right: -35px;

   
  background: radial-gradient(
    ellipse at center,
    rgba(245, 240, 225, 0.88) 0%,
    rgba(245, 240, 225, 0.55) 45%,
    rgba(245, 240, 225, 0) 78%
  );

  }
}
