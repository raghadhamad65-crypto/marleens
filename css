@media (max-width: 600px) {
  .hero__cta {
    min-width: 170px;
    padding: 13px 20px;
    font-size: 12px;
  }
}
@keyframes heroRise{
  from{ opacity:0; transform:translateY(18px); }
  to{ opacity:1; transform:translateY(0); }
}

.hero__scroll-cue{
  position:absolute;
  bottom:36px; left:50%;
  transform:translateX(-50%);
  z-index:2;
  width:1px; height:46px;
  background:rgba(255,255,255,0.35);
  opacity:0;
  animation:heroRise 1s ease forwards;
  animation-delay:2.1s;
}
.hero__scroll-cue span{
  position:absolute; top:0; left:-2px;
  width:5px; height:5px;
  border-radius:50%;
  background:var(--gold-light);
  animation:scrollCue 2.4s ease-in-out infinite;
  
}
@keyframes scrollCue{
  0%{ top:0; opacity:1; }
  90%{ opacity:0; }
  100%{ top:44px; opacity:0; }
}

@media (max-width:760px){
  .hero__content{
    align-items:center;
    text-align:center;
    padding-bottom:20%;
  }
  .hero__gradient{
    background:
      linear-gradient(0deg, rgba(14,12,9,0.92) 0%, rgba(14,12,9,0.35) 45%, rgba(14,12,9,0.15) 65%, rgba(14,12,9,0.55) 100%);
  }
  .hero__scroll-cue{ display:none; }
}

/* =========================================================
  /* =========================================================
   ABOUT — PREMIUM BRAND STORY*/
   .about {
  position: relative;
  padding: 120px 0 40px;
  overflow: hidden;
  background: var(--cream-alt);
}
.about::before {
  content: "";
  position: absolute;

  width: 420px;
  height: 420px;

  left: -220px;
  top: 50%;

  transform: translateY(-50%);

  border-radius: 50%;

  background: rgba(190, 157, 91, 0.07);

  pointer-events: none;
}


/* ===== الزخارف ===== */

.about__decor {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 1;
}


/* أوراق الزيتون */

.olive-leaf {
  position: absolute;

  font-size: 55px;

  opacity: 0.18;

  filter:
    sepia(20%)
    saturate(70%);

  animation: oliveFloat 7s ease-in-out infinite;
}


/* أماكن الأوراق */

.leaf-1 {
  left: 5%;
  top: 15%;
  transform: rotate(-25deg);
  animation-delay: 0s;
}

.leaf-2 {
  right: 7%;
  top: 20%;
  font-size: 45px;
  transform: rotate(30deg);
  animation-delay: 2s;
}

.leaf-3 {
  right: 12%;
  bottom: 12%;
  font-size: 65px;
  transform: rotate(-20deg);
  animation-delay: 4s;
}


/* البذور */

.seed {
  position: absolute;

  width: 10px;
  height: 16px;

  border-radius: 50% 50% 45% 45%;

  background: #68a11de8;

  opacity: 0.35;

  box-shadow:
    0 0 8px #34ca66df;

  animation: seedFloat 6s ease-in-out infinite;
}


/* أماكن البذور */

.seed-1 {
  left: 18%;
  top: 25%;
  animation-delay: 1s;
}

.seed-2 {
  left: 35%;
  bottom: 15%;
  animation-delay: 3s;
}

.seed-3 {
  right: 25%;
  top: 12%;
  animation-delay: 2s;
}

.seed-4 {
  right: 8%;
  bottom: 30%;
  animation-delay: 4s;
}


/* حركة الأوراق */

@keyframes oliveFloat {

  0% {
    transform: translateY(0) rotate(-20deg);
  }

  50% {
    transform: translateY(-18px) rotate(-5deg);
  }

  100% {
    transform: translateY(0) rotate(-20deg);
  }

}


/* حركة البذور */

@keyframes seedFloat {

  0% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-25px) rotate(20deg);
  }

  100% {
    transform: translateY(0) rotate(0deg);
  }

}


/* محتوى القسم فوق الزخارف */

.about__inner {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns: 0.9fr 1.1fr;

  align-items: center;

  gap: 90px;
}

/* =========================
   IMAGE
