<script>
document.addEventListener("DOMContentLoaded", function () {

  const shopBtn = document.getElementById("shopNowBtn");

  if (!shopBtn) return;

  shopBtn.addEventListener("click", function (e) {

    e.preventDefault();

    const rect = shopBtn.getBoundingClientRect();

    const particles = [

      // 🌿 أوراق
      { type: "leaf",  x: -55, y: -85,  r: -35 },
      { type: "leaf",  x: 50,  y: -105, r: 35 },
      { type: "leaf",  x: -85, y: -35,  r: -60 },
      { type: "leaf",  x: 90,  y: -45,  r: 55 },
      { type: "leaf",  x: -25, y: -125, r: -15 },

      // 🫒 زيتون
      { type: "olive", x: -35, y: -110, r: -20 },
      { type: "olive", x: 65,  y: -75,  r: 30 },
      { type: "olive", x: -75, y: -75,  r: -35 },

      // 🌰 بذور
      { type: "seed", x: -105, y: -15,  r: 20 },
      { type: "seed", x: 105,  y: -20,  r: -25 },
      { type: "seed", x: -75,  y: -115, r: 40 },
      { type: "seed", x: 90,   y: -120, r: -40 },
      { type: "seed", x: 20,   y: -140, r: 15 }

    ];

    particles.forEach((particle, index) => {

      const element = document.createElement("span");

      element.className =
        "nature-particle " + particle.type;

      element.style.left =
        (rect.left + rect.width / 2) + "px";

      element.style.top =
        (rect.top + rect.height / 2) + "px";

      element.style.setProperty(
        "--x",
        particle.x + "px"
      );

      element.style.setProperty(
        "--y",
        particle.y + "px"
      );

      element.style.setProperty(
        "--rotate",
        particle.r + "deg"
      );

      element.style.animationDelay =
        (index * 35) + "ms";

      document.body.appendChild(element);

      setTimeout(() => {
        element.remove();
      }, 1200);

    });

  });

});
</script>
